# Guard Agent configuration (BNB Chain). Copy to .env (gitignored).

# true  -> in-memory MockLedger, no network (default, used by tests).
# false -> CerminRWA contract on BNB Chain via viem.
MOCK_LEDGER=true

# 97 = BSC testnet (default), 56 = BSC mainnet.
CHAIN_ID=97
BSC_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# From contracts/script/Deploy.s.sol output. TODO: fill after deploy.
CERMIN_RWA_ADDRESS=

# The Guard Agent's own key (its address must be GUARD_AGENT_ADDRESS at deploy
# and is named as guardAgent on each loan/policy/vault). Needs a little tBNB for
# gas: https://www.bnbchain.org/en/testnet-faucet . NEVER commit a real key.
GUARD_AGENT_PRIVATE_KEY=

# Poll interval (ms). BSC blocks are ~0.75-3s; 5s is plenty.
POLL_MS=5000
