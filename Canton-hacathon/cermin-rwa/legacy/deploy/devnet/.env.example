# Cermin-RWA — Canton DevNet validator config (Task 13 prep)
# Copy to .env (gitignored by the repo-root .gitignore's `.env.*` rule) and
# fill in real values once your sponsor's IP allowlist has cleared.
# NO REAL SECRETS ARE COMMITTED HERE — every value below is a placeholder.
#
# These variables map 1:1 onto the OFFICIAL splice-node release bundle's own
# `start.sh` flags. We do NOT vendor Digital Asset's docker-compose.yml into
# this repo — see README.md "Why no docker-compose.yml in this repo".
#
# Verified against (fetched/re-verified 2026-07-11):
#   https://docs.dev.sync.global/validator_operator/validator_onboarding.html
#   https://docs.dev.sync.global/validator_operator/validator_compose.html
#   https://docs.sync.global/validator_operator/validator_hardware_requirements.html
#   https://github.com/digital-asset/decentralized-canton-sync/releases

# --- splice-node release bundle to download (fetch-validator-bundle.sh) ---
# Pin re-verified 2026-07-11 via `gh api repos/digital-asset/decentralized-canton-sync/releases`:
# latest was v0.6.12 (published 2026-07-09) — one point release ahead of the
# v0.6.11 LocalNet images used in Task 12, just two days earlier. Splice ships
# roughly weekly: RE-CHECK the releases page at deploy time, don't trust this
# pin blindly.
SPLICE_NODE_VERSION=0.6.12

# --- start.sh -s : your sponsor Super Validator's SV app URL ---
# [USER ACTION] You must line up a sponsor first — see docs/07-devnet.md
# "Onboarding steps", step 1. Must be the `sv.` app URL, NOT the `scan.` URL.
# Shape (from Digital Asset's own example): https://sv.sv-2.dev.global.canton.network.<sponsor-domain>
SPONSOR_SV_URL=

# --- start.sh -o : one-time onboarding secret ---
# DevNet only: self-generate right before running start.sh (see README step 5):
#   curl -X POST "$SPONSOR_SV_URL/api/sv/v0/devnet/onboard/validator/prepare"
# Valid for ONE HOUR — do not generate this in advance and let it sit in .env.
ONBOARDING_SECRET=

# --- start.sh -p : your validator's party hint ---
# Same party-hint rules learned on LocalNet (STATE.md lesson: Canton 3 party
# ids are `hint::fingerprint`, no display names — matchesPartyHint-style code
# must match on that shape). Pick something recognizable.
PARTY_HINT=cermin-rwa-devnet-1

# --- start.sh -m : current network migration id ---
# [USER ACTION] Look up the CURRENT value at https://canton.foundation/sv-network/
# (JS-rendered dashboard — open in a real browser, DevNet section). Do not
# guess or reuse an old value; it changes on every network migration.
MIGRATION_ID=

# --- start.sh -a : enable real OIDC auth (the "production" DevNet auth model) ---
# Leave false to boot with the bundle's DEFAULT dev-mode self-signed-JWT auth
# (Digital Asset's own docs call this "highly insecure", fine for a first
# smoke test only). Set true once you have an OIDC app registered (Auth0 or
# Keycloak) — see docs/07-devnet.md "Auth model: DevNet vs LocalNet".
ENABLE_OIDC_AUTH=false

# --- only used when ENABLE_OIDC_AUTH=true ---
AUTH_URL=
AUTH_JWKS_URL=
AUTH_WELLKNOWN_URL=
LEDGER_API_AUTH_AUDIENCE=
LEDGER_API_AUTH_SCOPE=
VALIDATOR_AUTH_AUDIENCE=
VALIDATOR_AUTH_CLIENT_ID=
VALIDATOR_AUTH_CLIENT_SECRET=
LEDGER_API_ADMIN_USER=
WALLET_ADMIN_USER=
WALLET_UI_CLIENT_ID=
ANS_UI_CLIENT_ID=

# --- optional ---
# Operator contact shown to the network (per validator_compose.rst).
CONTACT_POINT=
