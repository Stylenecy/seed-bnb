# Cermin-RWA backend configuration (BNB Chain). Copy to .env (gitignored).

PORT=3001

# true (default) -> in-memory MockLedger (no network).
# false          -> CerminRWA contract on BNB Chain via viem.
MOCK_LEDGER=true

# 97 = BSC testnet (default), 56 = BSC mainnet.
CHAIN_ID=97
BSC_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# From contracts/script/Deploy.s.sol output. TODO: fill after deploy.
CERMIN_RWA_ADDRESS=

# Operator key = issuer + pool operator + oracle (the deployer). Funds users'
# gas drips too, so keep it stocked with tBNB. NEVER commit a real key.
OPERATOR_PRIVATE_KEY=
# The Guard Agent's address (agent/.env GUARD_AGENT_PRIVATE_KEY's address).
GUARD_AGENT_ADDRESS=

# Custodial demo accounts: each username maps to an EOA derived from this
# secret. TESTNET ONLY. Changing it changes every user's address.
USER_KEY_SECRET=
# tBNB sent to a user account when its gas runs low (default 0.003 BNB).
GAS_DRIP_WEI=3000000000000000
# address -> username map so keys can be re-derived after a restart.
USERS_DB_PATH=./data/users.json

# Optional read-only borrower shown for /api/position without X-Cermin-Party.
LEGACY_BORROWER_ADDRESS=
