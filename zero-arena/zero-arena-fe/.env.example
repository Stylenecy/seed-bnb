# zero-arena-fe — public Next.js env. Copy to `.env.local` and adjust.

# ─── Chain: BNB Smart Chain ───────────────────────────────────────────────
# 97 = BSC testnet (default), 56 = BSC mainnet.
NEXT_PUBLIC_CHAIN_ID=97
# Override to point at a dedicated RPC (NodeReal / Ankr / QuickNode). The
# bnbchain.org testnet dataseed rejects eth_getLogs, so use publicnode. Mainnet: https://bsc-dataseed.bnbchain.org
NEXT_PUBLIC_BSC_RPC_URL=https://bsc-testnet-rpc.publicnode.com
# Block the contracts were deployed at (fromBlock for log scans) + max
# eth_getLogs span per request.
NEXT_PUBLIC_DEPLOY_BLOCK=132984371
NEXT_PUBLIC_LOGS_CHUNK=5000

# ─── Contracts on BSC ─────────────────────────────────────────────────────
# BSC testnet (97) deploy of 2026-09-25 (contracts/deployments/97.json +
# 97-paper-engine.json). Unset → dashboard falls back to placeholder data.
NEXT_PUBLIC_AGENT_CERTIFICATE_ADDRESS=0x4927B51f574035622826d8E703b712Bb5F12bDC8
NEXT_PUBLIC_ZERO_ARENA_INFT_ADDRESS=0x6d0fda52C480E96D2Da3aB0e071d4c6A27Cd263c
NEXT_PUBLIC_REENCRYPTION_ORACLE_ADDRESS=0x90D159C2d0d247BAafbd865a6FdD664E397eD984
NEXT_PUBLIC_LIVE_CERTIFICATE_ADDRESS=0xc013bf70429B079D076e36D966A16F382b9c7e46
NEXT_PUBLIC_SEASON_ADDRESS=0xA50314e3d9Abd8f35134a91Fe117a18e06461a55

# ─── Backend services (zero-arena-bacend) ─────────────────────────────────
# Transfer-oracle has a default in lib/be/transfer-oracle.ts; the onboard URL
# has NO default — the "Delegate agent" dialog feature-gates on it. Both
# services must be redeployed with ZA_RPC/ZA_CHAIN_ID pointing at BSC.
NEXT_PUBLIC_TRANSFER_ORACLE_URL=https://transfer-oracle-production-f390.up.railway.app
NEXT_PUBLIC_ONBOARD_URL=https://onboard-production-ed6c.up.railway.app

# ─── WalletConnect ────────────────────────────────────────────────────────
# Create a project at https://cloud.walletconnect.com and paste its projectId.
# Without a real ID only injected wallets (MetaMask / Rabby / Binance Web3
# Wallet extension) work.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=YOUR_WALLETCONNECT_PROJECT_ID
