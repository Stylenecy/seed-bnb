# ─── BNB Smart Chain testnet (chainId 97) — default target ──────────────
#
# Faucet: https://www.bnbchain.org/en/testnet-faucet
# Explorer: https://testnet.bscscan.com
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# ─── BNB Smart Chain mainnet (chainId 56) ────────────────────────────────
#
# No faucet — the DEPLOYER wallet must hold real BNB to pay gas.
# Explorer: https://bscscan.com
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org

# BscScan / Etherscan-v2 API key for `forge script --verify`
BSCSCAN_API_KEY=

# ─── Deployer wallet (admin / Ownable2Step on every contract) ────────────
#
# DEPLOYER_ADDRESS must equal `cast wallet address $DEPLOYER_PRIVATE_KEY`.
# For mainnet, use a FRESH wallet — do NOT reuse the testnet deployer.
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=

# ─── Oracle service signer ───────────────────────────────────────────────
#
# Address written into ReencryptionOracle at deploy time. The matching
# private key lives in zero-arena-bacend/.env on the host running the
# transfer-oracle service — never in this repo, never in the SDK.
#
# v0.1 oracle is a trusted-ECDSA stub. Holding ORACLE_PRIVATE_KEY on
# mainnet means the holder can forge any ERC-7857 transfer. Use a
# hardware-wallet-backed key for mainnet; rotate via setSigner() if
# compromised. v0.4 swaps verifyTransfer() for 0G Compute TEE quote
# verification (TODO: TEE backend on BNB) — same call shape, no client code change.
ORACLE_SIGNER_ADDRESS=

# ─── Paper-engine operator wallet ────────────────────────────────────────
#
# Authorized in LiveCertificate.authorizedUpdaters at deploy time of
# DeployPaperEngine.s.sol. Pays gas for every EpochCommitted tx. Reused
# by season-keeper for permissionless settle calls.
OPERATOR_ADDRESS=

# ─── Existing iNFT address (only needed for DeployPaperEngine.s.sol) ─────
#
# After running DeployAll.s.sol, copy the ZeroArenaINFT address from
# deployments/<chainId>.json here, then run DeployPaperEngine.s.sol.
ZA_ADDR_INFT=
