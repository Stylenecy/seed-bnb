# Your SDK consumer config. Copy to `examples/.env` and fill PRIVATE_KEY.

# Contracts: BNB Smart Chain testnet (97). Mainnet (56): https://bsc-dataseed.bnbchain.org
ZA_RPC=https://data-seed-prebsc-1-s1.bnbchain.org:8545
ZA_CHAIN_ID=97
# Blob storage: 0G Storage. Upload fees are paid on 0G Chain via ZA_STORAGE_RPC.
ZA_INDEXER=https://indexer-storage-turbo.0g.ai
ZA_STORAGE_RPC=https://evmrpc.0g.ai

# Your wallet. Signs your certify + mintAgent tx, pays your gas, owns your iNFT.
# Fund with testnet BNB (https://www.bnbchain.org/en/testnet-faucet) + a little 0G for storage fees.
PRIVATE_KEY=0x

# BSC testnet deployment (2026-09-25), from contracts/deployments/97.json.
ZA_ADDR_CERT=0x4927B51f574035622826d8E703b712Bb5F12bDC8
ZA_ADDR_INFT=0x6d0fda52C480E96D2Da3aB0e071d4c6A27Cd263c
ZA_ADDR_ORACLE=0x90D159C2d0d247BAafbd865a6FdD664E397eD984

# Arena layer — needed by scripts/{create-season,enroll-all,season-status}.ts.
# From contracts/deployments/97-paper-engine.json.
ZA_ADDR_LIVE_CERT=0xc013bf70429B079D076e36D966A16F382b9c7e46
ZA_ADDR_SEASON=0xA50314e3d9Abd8f35134a91Fe117a18e06461a55

# Optional — defaults to ~/.zeroarena/keys
# ZA_KEYS_DIR=
