# ─── BNB Chain (contracts: ConvictionLog + MusashiINFT) ───
# Default: BSC Testnet (chainId 97). For BSC Mainnet (56) use
#   BSC_RPC_URL=https://bsc-dataseed.bnbchain.org  and  BSC_EXPLORER_URL=https://bscscan.com
# Testnet BNB faucet: https://www.bnbchain.org/en/testnet-faucet
BSC_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
BSC_EXPLORER_URL=https://testnet.bscscan.com
BSC_PRIVATE_KEY=                # OPTIONAL — only for on-chain publishing (hex, with or without 0x). Use a dedicated wallet.
ETHERSCAN_API_KEY=              # OPTIONAL — Etherscan V2 key (covers BscScan) for contract verification in `make deploy`

# Deployed proxy addresses on BNB Chain — TODO: fill in after `make deploy`
# (the deploy script writes them here automatically).
CONVICTION_LOG_ADDRESS=
MUSASHI_INFT_ADDRESS=

# Frontend (Next.js) — public chain config
# 97 = BSC Testnet, 56 = BSC Mainnet (copy these into frontend/.env.local)
NEXT_PUBLIC_CHAIN_ID=97
# NEXT_PUBLIC_BSC_RPC_URL=      # optional RPC override for the browser
NEXT_PUBLIC_CONVICTION_LOG_ADDRESS=
NEXT_PUBLIC_MUSASHI_INFT_ADDRESS=

# ─── 0G Storage (evidence + encrypted intelligence blobs) ───
# Storage stays on 0G Storage (off-chain DA); only merkle roots are written on BSC.
# Uploads are paid on the 0G network, so this wallet needs 0G gas. Falls back to
# BSC_PRIVATE_KEY when unset. Requires the `0g-storage-client` CLI.
OG_STORAGE_PRIVATE_KEY=
OG_STORAGE_RPC=https://evmrpc.0g.ai
OG_STORAGE_INDEXER=https://indexer-storage-turbo.0g.ai
# OG_STORAGE_SCAN_URL=https://storagescan.0g.ai
# OG_STORAGE_EXPLORER_URL=https://chainscan.0g.ai

# ─── Analysis daemon (read-only HTTP) ───
# The web dashboard calls `musashi-core serve` over HTTP instead of spawning the
# binary per request. Start it with:  musashi-core serve  (defaults to :8787).
# It is READ-ONLY and needs no private key. Point the dashboard at it here.
MUSASHI_DAEMON_URL=http://127.0.0.1:8787
# Optional shared secret — if set, the daemon requires X-Api-Key on every request
# (pass the same value to `musashi-core serve --api-key` or MUSASHI_DAEMON_KEY).
# MUSASHI_DAEMON_KEY=

# ─── Online Mode (hosted preview / no-local-install demos) ───
# When GEMINI_API_KEY is set, the dashboard chat exposes an extra "Gemini Online"
# tab that runs the MUSASHI persona via Gemini 2.5 Flash with function-calling.
# This lets the agent work on Vercel/serverless deploys where the local `claude`
# and `openclaw` CLIs are not available. Get a key:
#   https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
MUSASHI_ONLINE_MODEL=gemini-2.5-flash
# Optional: override Gemini API endpoint (mostly for proxies / regional tests)
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# ─── Claude via Hermes (production chat — "anyone can try it") ───
# Routes the dashboard's Claude tab through an OpenAI-compatible gateway (Hermes
# Agent proxy, Nous Portal, OpenRouter, LiteLLM, or your own self-hosted endpoint).
# Pure HTTP + the constrained MUSASHI tool registry → works for everyone on hosted
# deploys, no per-user CLI install. When HERMES_API_KEY is set, the Claude tab uses
# this automatically (falls back to local Claude Code only if MUSASHI_ENABLE_LOCAL_AGENTS=1).
HERMES_API_URL=https://openrouter.ai/api/v1   # base URL (no trailing /chat/completions)
HERMES_API_KEY=
HERMES_MODEL=anthropic/claude-sonnet-4         # model id as the gateway names it

# ─── Local shell-capable agents (Claude Code / OpenClaw) ───
# OFF by default. These run a shell-capable agent; exposing them via the chat
# HTTP endpoint is a remote-code-execution risk (see AUDIT.md S1). Only enable
# in a trusted local environment you control. The default chat runtime is the
# Gemini "online mode" above, which uses a constrained tool registry (no shell).
# MUSASHI_ENABLE_LOCAL_AGENTS=1
