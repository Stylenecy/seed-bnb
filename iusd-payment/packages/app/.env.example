# ── iUSD Pay frontend — BNB Smart Chain ──────────────────────────────
# 97 = BSC testnet (default), 56 = BSC mainnet
VITE_EVM_CHAIN_ID=97
# Optional RPC override (defaults to the public BNB Chain endpoint for the chain)
VITE_BSC_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
VITE_EXPLORER_TX_BASE=https://testnet.bscscan.com/tx
VITE_EXPLORER_BASE=https://testnet.bscscan.com

# Contracts (printed by scripts/deploy/bsc-deploy.sh)
VITE_IPAY_POOL_ADDRESS=
VITE_GIFT_POOL_ADDRESS=
# Legacy key, kept for code that expects a "module address": use the IPayPool address
VITE_MODULE_ADDRESS=

# ERC-20 stablecoin. Testnet: MockERC20 from the deploy script.
# Mainnet USDT: 0x55d398326f99059fF775485246999027B3197955 (18 decimals on BSC)
VITE_IUSD_FA=
VITE_TOKEN_DECIMALS=18
VITE_TOKEN_SYMBOL=USDT

# Backend
VITE_API_BASE=http://localhost:3001/v1
VITE_APP_URL=http://localhost:5173
