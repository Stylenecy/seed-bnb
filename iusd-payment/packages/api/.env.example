# ── iUSD Pay API + relayer — BNB Smart Chain ─────────────────────────
# 97 = BSC testnet (default), 56 = BSC mainnet
EVM_CHAIN_ID=97
BSC_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
# Prefix for legacy Initia-REST-shaped lookups; answered locally from BSC (lib/bnb/evm.ts)
REST_URL=https://bsc.compat.local

# Contracts (printed by scripts/deploy/bsc-deploy.sh)
IPAY_POOL_ADDRESS=
GIFT_POOL_ADDRESS=
# Legacy key: set to the IPayPool address
MODULE_ADDRESS=

# ERC-20 stablecoin (testnet MockERC20 / mainnet USDT 0x55d398326f99059fF775485246999027B3197955)
IUSD_FA=
TOKEN_DECIMALS=18

TREASURY_ADDRESS=
DEPLOYER_ADDRESS=

# Relayer wallets (BIP-39 mnemonics). Each derived address must be added as
# sponsor on both pools (addSponsor) and funded with BNB for gas.
RELAYER_MNEMONIC=
RELAYER_PAY_COUNT=1
RELAYER_GIFT_COUNT=1
RELAYER_SWEEP_COUNT=1
RELAYER_MNEMONICS_PAY=
RELAYER_MNEMONICS_GIFT=
RELAYER_MNEMONIC_SWEEP=

# Security (generate your own; never commit real values)
SERVER_SECRET=
JWT_SECRET=
ADMIN_KEY=

APP_URL=http://localhost:5173
PORT=3001
