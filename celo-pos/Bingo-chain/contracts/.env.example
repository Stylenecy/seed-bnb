# --- Celo Mainnet (live deployment) ------------------------------------------
CELO_MAINNET_RPC=https://forno.celo.org

# Deployer (pays gas). On mainnet the owner MUST differ from the deployer, so the
# upgrade key is not the hot deploy key (Deploy.s.sol enforces this on chain 42220).
DEPLOYER_PRIVATE_KEY=0x...
DEPLOYER_ADDRESS=0x...

# Initial owner (a Safe multisig) and treasury for the proxy initializer.
OWNER_ADDRESS=
TREASURY_ADDRESS=
PROTOCOL_FEE_BPS=100

# --- BNB Chain (multichain expansion) ----------------------------------------
# forge script script/Deploy.s.sol --rpc-url bsc_testnet --broadcast --verify
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.bnbchain.org:8545
BSC_MAINNET_RPC=https://bsc-dataseed.bnbchain.org

# --- Verification -----------------------------------------------------------
# Unified Etherscan API V2 key — works for Celo, BSC (97/56) + 60+ other EVM chains.
# Get one at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# Note: on Celo this project is mainnet-only (fork with `anvil --fork-url $CELO_MAINNET_RPC`).
# On BNB Chain, BSC testnet (97) is the default target before mainnet (56).
