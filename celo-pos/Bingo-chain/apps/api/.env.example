# Postgres connection string. On Railway this is injected from the Postgres
# service — set DATABASE_URL = ${{Postgres.DATABASE_URL}} on the api service.
DATABASE_URL=postgres://user:pass@host:5432/railway

# Port (Railway sets this automatically; defaults to 8080 locally).
PORT=8080

# --- Chain (multichain: one API instance + database per chain) ---------------
# 42220 = Celo mainnet (default, live) | 97 = BSC testnet | 56 = BSC mainnet
CHAIN_ID=42220
# Optional RPC override (defaults: forno.celo.org / bsc-testnet-rpc.publicnode.com / bsc-dataseed.bnbchain.org; BSC needs an eth_getLogs-capable RPC)
RPC_URL=
# Required on BSC (TODO after deploy); Celo defaults to the live proxy 0x8bE7…32f1
BINGO_ADDRESS=
INDEX_START_BLOCK=
