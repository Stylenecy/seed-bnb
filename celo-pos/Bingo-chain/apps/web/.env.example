# BINGOChain web — multichain (Celo live + BNB Chain expansion)
# Active network at build time: 42220 = Celo mainnet (default, live), 97 = BSC testnet, 56 = BSC mainnet
NEXT_PUBLIC_CHAIN_ID=42220

# Celo (existing deployment; addresses are baked into lib/networks.ts)
NEXT_PUBLIC_CELO_MAINNET_RPC=https://forno.celo.org

# BNB Chain testnet (97) — fill after deploying (see MIGRATION-BNB.md)
NEXT_PUBLIC_BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.bnbchain.org:8545
NEXT_PUBLIC_BSC_TESTNET_BINGO_ADDRESS=
NEXT_PUBLIC_BSC_TESTNET_LANCE_ADDRESS=
NEXT_PUBLIC_BSC_TESTNET_USDT_ADDRESS=   # MockERC20, 18 decimals

# BNB Chain mainnet (56)
NEXT_PUBLIC_BSC_MAINNET_RPC=https://bsc-dataseed.bnbchain.org
NEXT_PUBLIC_BSC_BINGO_ADDRESS=
NEXT_PUBLIC_BSC_LANCE_ADDRESS=
NEXT_PUBLIC_API_URL=   # BINGOChain API (run one API instance per chain; see apps/api)
