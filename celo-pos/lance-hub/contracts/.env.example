# LanceHub deploy config — Celo (live) + BNB Chain (expansion). Never commit a real .env.
# Celo mainnet (existing deployment, script/Deploy.s.sol)
CELO_MAINNET_RPC=https://forno.celo.org
MAINNET_DEPLOYER_PRIVATE_KEY=
# BNB Chain (script/DeployBsc.s.sol) — testnet 97 default, mainnet 56
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.bnbchain.org:8545
BSC_MAINNET_RPC=https://bsc-dataseed.bnbchain.org
DEPLOYER_PRIVATE_KEY=
# Etherscan V2 multichain key (Celoscan 42220 + BscScan 97/56)
ETHERSCAN_API_KEY=
# Optional BSC overrides
# POOL_ASSET=      # defaults to canonical WBNB for the chain
# OWNER=           # defaults to deployer; set to operator Safe for mainnet
# SEED_AMOUNT=10000000000000000   # 0.01 WBNB (wei); 0 = skip seed
