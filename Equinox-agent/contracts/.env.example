# Equinox contracts — BNB Smart Chain. Copy to .env and fill in. Never commit .env.
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
ETHERSCAN_API_KEY=

# Deployer key (needs BNB for gas; testnet faucet: https://www.bnbchain.org/en/testnet-faucet)
PRIVATE_KEY=

# Optional role holders (default: deployer)
AGENT_ADDRESS=
ORACLE_KEEPER_ADDRESS=

# Token addresses. On BSC Testnet (97) leave empty: the script deploys 18-dec mocks.
# BSC Mainnet (56): WBNB 0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c,
#                   USDT 0x55d398326f99059fF775485246999027B3197955 (18 decimals!)
COLLATERAL_TOKEN=
DEBT_TOKEN=

# Chainlink AggregatorV3 feeds (USD). Leave empty to use keeper-push prices only.
# BSC Mainnet (verified on-chain 2026-09, 8 decimals): BNB/USD 0x0567F2323251f0Aab15c8dFb1967E4e8A7D42aeE,
#   USDT/USD 0xB97Ad0E74fa7d920791E90258A6E2085088b4320, BTC/USD 0x264990fbd0A4796A3E3d8E37C4d5F87a3aCa5Ebf
# BSC Testnet: leave empty (mock tokens) and push prices with PriceOracle.setPrice (ORACLE_ROLE).
# Venus vTokens for VenusAdapter (mainnet): vUSDT 0xfD5840Cd36d94D7229439859C0112a4185BC0255,
#   vBTC 0x882C173bC7Ff3b7786CA16dfeD3DFFfb9Ee7847B. vBNB is native (no underlying()) -> not adapter-compatible.
COLLATERAL_PRICE_FEED=
DEBT_PRICE_FEED=
