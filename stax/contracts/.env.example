# Deployer key (use a throwaway key with a small BNB / tBNB balance for gas)
# tBNB faucet: https://www.bnbchain.org/en/testnet-faucet
PRIVATE_KEY=

# RPCs
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org

# Etherscan API key (V2 multichain — covers BscScan verification) — https://etherscan.io/apis
ETHERSCAN_API_KEY=

# Off-chain agent signer (the EIP-712 risk-inference signer; its address is set as trusted in InferenceVerifier)
AGENT_SIGNER_ADDRESS=

# Settlement stablecoin (18 decimals on BSC).
#   bsc mainnet: defaults to Binance-Peg USDC 0x8AC76a51cc950d9822D68b83fE1Ad97B32Cd580d
#                (USDT alternative: 0x55d398326f99059fF775485246999027B3197955)
#   bscTestnet:  leave empty to deploy a MockERC20 ("Mock USDC", 18 dec) automatically
STABLE_ADDRESS=

# DEX router whitelisted on the executor. Default: PancakeSwap V3 SwapRouter
# 0x1b81D678ffb9C0263b24A97847620C99d213eB14 (BSC mainnet + testnet).
DEX_ROUTER=

# Comma-separated token addresses the executor may buy (tokenized stocks etc. on BSC).
# TODO: fill with the BSC tokenized-stock addresses — the Mantle xStock addresses do not exist on BSC.
ASSET_TOKENS=

# For scripts/enable-assets.js: the deployed executor + extra routers/assets to whitelist
STAX_EXECUTOR=
EXTRA_ROUTERS=
EXTRA_ASSETS=

AGENT_CARD_URI=https://www.stax.best/.well-known/agent-card.json
